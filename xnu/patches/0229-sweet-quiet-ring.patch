+/*
+ * SWEET (0229): lines the ring does not keep.  The FILL/UPL/COMMIT traces were
+ * written for single rounds and now print tens of thousands of lines per boot
+ * (every 16 KiB page of every exec'd image), which buries the lines that matter
+ * in the QR stream and on the panel.  Only whole lines that start a chunk and
+ * begin at a line boundary are dropped, so a chunk that carries several lines
+ * is kept verbatim; the console still prints everything, this filter only
+ * trims the ring (and therefore the QR log and the "sweetlog" flush).
+ * Boot-arg sweetlogall=1 keeps them.
+ */
+static const char *const sweet_log_quiet[] = {
+	"SWEET UPLOBJ:", "SWEET COMMIT:", "SWEET COMMITPAGE:", "SWEET COMMITLITE:",
+	"SWEET CLCOMMIT:", "SWEET CLFLAGS:", "SWEET CLDONE:", "SWEET UPLPHYS:",
+	"SWEET PAGEIN:", "SWEET ZCHUNK:", "SWEET ZPAGE:", "SWEET CACHE:",
+	"SWEET BUFMAP:", "SWEET UFSREAD:", "SWEET UPLMAP:", "SWEET MAPSEG:",
+	"SWEET TLBFIX:", "SWEET USERPHYS:", "SWEET UBCOBJ:", "SWEET PMAPFILL:",
+	"SWEET FILLPAGE:", "SWEET OBJFILL:", "SWEET VB:", "SWEET WIRE:",
+	"SWEET UFS: RD ", "SWEET CS: dyld sig off", "SWEET CS: launchd sig off",
+	NULL
+};
+static int sweet_log_bol = 1;   /* the last chunk ended a line */
+static int sweet_log_quiet_state;       /* 0 = boot-args not read yet, 1 = quiet, 2 = keep all */
+
+static int
+sweet_log_quiet_on(void)
+{
+	int s = sweet_log_quiet_state;
+	if (s == 0) {
+		int v = 0;
+		s = (PE_state.bootArgs != NULL &&
+		    PE_parse_boot_argn("sweetlogall", &v, sizeof(v)) && v != 0) ? 2 : 1;
+		sweet_log_quiet_state = s;
+	}
+	return s != 2;
+}
+
+static int
+sweet_log_is_quiet(const char *c, int size)
+{
+	if (!sweet_log_quiet_on()) {
+		return 0;
+	}
+	for (int i = 0; sweet_log_quiet[i] != NULL; i++) {
+		const char *p = sweet_log_quiet[i];
+		int n = 0;
+		while (p[n] != '\0') {
+			n++;
+		}
+		if (n <= size && memcmp(c, p, (size_t)n) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
 
