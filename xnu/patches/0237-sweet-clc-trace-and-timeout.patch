+/* SWEET (0237): see the CLFLAGS site in cluster_commit(). */
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+
+static thread_call_t sweet_clc_tc;
+static uint32_t sweet_clc_size;
+
+static void
+sweet_clc_fire(void *a, void *b)
+{
+	(void)a;
+	(void)b;
+	panic("SWEET CLC: ubc_upl_commit_range stuck, size %u", sweet_clc_size);
+}
+
+int
+sweet_clc_arm(uint32_t size)
+{
+	uint64_t deadline;
+
+	if (sweet_clc_tc == NULL) {
+		sweet_clc_tc = thread_call_allocate(sweet_clc_fire, NULL);
+		if (sweet_clc_tc == NULL) {
+			return 0;
+		}
+	}
+	sweet_clc_size = size;
+	clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
+	return thread_call_enter_delayed(sweet_clc_tc, deadline) ? 1 : 0;
+}
+
+void
+sweet_clc_disarm(void)
+{
+	if (sweet_clc_tc != NULL) {
+		thread_call_cancel(sweet_clc_tc);
+	}
+}
