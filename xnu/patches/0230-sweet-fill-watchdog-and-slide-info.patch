+/*
+ * SWEET (0230): the forced fill can stop dead without panicking.  R94's QR log
+ * ends at two zero blocks of the launchd entry page and nothing follows for the
+ * next two minutes: the exec thread is stuck inside the loop, the panel keeps
+ * showing the same QR, and a stuck boot looks exactly like a slow one.  Watch
+ * the loop position from a thread and panic (loop state + stack on the panel)
+ * when it stops moving.
+ */
+static _Atomic uint64_t sweet_fill_pos;
+static _Atomic uint64_t sweet_fill_off;
+static _Atomic uint32_t sweet_fill_on;
+static int sweet_fill_wd_started;
+static int sweet_fill_chan;
+
+static void
+sweet_fill_watchdog(void *arg, wait_result_t wr)
+{
+	uint64_t last = ~(uint64_t)0;
+	int still = 0;
+
+	(void)arg;
+	(void)wr;
+	for (;;) {
+		(void)tsleep(&sweet_fill_chan, PZERO, "sweetfill", hz);
+		if (!sweet_fill_on) {
+			last = ~(uint64_t)0;
+			still = 0;
+			continue;
+		}
+		uint64_t pos = sweet_fill_pos;
+
+		if (pos == last) {
+			/* Say it, do not panic: a panic stops this thread and the
+			 * QR channel with it, while a stuck boot keeps the panel
+			 * and the stream alive.  One line every ~4 s is cheap. */
+			if (++still >= 4) {
+				printf("SWEET STALL: pos %llu off %#llx n %d\n",
+				    (unsigned long long)pos,
+				    (unsigned long long)sweet_fill_off,
+				    still);
+				still = 0;
+			}
+		} else {
+			last = pos;
+			still = 0;
+		}
+	}
+}
