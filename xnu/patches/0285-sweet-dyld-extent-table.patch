+		if (sweet_dyld_bpn_tbl[mid].foff < foff) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	if (lo >= (uint32_t)(sizeof(sweet_dyld_bpn_tbl) /
+	    sizeof(sweet_dyld_bpn_tbl[0])) ||
+	    sweet_dyld_bpn_tbl[lo].foff != foff) {
+		return -1;
+	}
+	return (daddr64_t)sweet_dyld_bpn_tbl[lo].bpn;
