 static void vm_shared_region_destroy(vm_shared_region_t shared_region);
 
+/* SWEET (R195): BSD side cannot dereference vm_shared_region_t; expose a
+ * setter so the check_np fallback can install a synthetic first mapping. */
+void
+sweet_sr_set_first(void *srp)
+{
+	vm_shared_region_t sr = (vm_shared_region_t)srp;
+
+	if (sr != NULL) {
+		sr->sr_first_mapping = 0;
+	}
+}
