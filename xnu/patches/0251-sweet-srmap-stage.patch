--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2082,6 +2082,15 @@ SYSCTL_INT(_vm, OID_AUTO, shared_region_persistence, CTLFLAG_RW | CTLFLAG_LOCKED
  * ENOMEM	shared region is empty
  * EFAULT	bad address for "start_address"
  */
+/* SWEET (0249): the map result outlives the window the QR channel can carry,
+ * so keep it and print it again whenever check_np fails. */
+static uint32_t sweet_srmap_files;
+static uint32_t sweet_srmap_noslide;
+static int sweet_srmap_kr = -1;
+static int sweet_srmap_error = -1;
+static uint32_t sweet_srmap_mappings;
+static int sweet_srmap_stage;
+
 int
 shared_region_check_np(
 	__unused struct proc                    *p,
@@ -2124,6 +2133,20 @@ shared_region_check_np(
 			/* retrieve address of its first mapping... */
 			kr = vm_shared_region_start_address(shared_region, &start_address, task);
 			if (kr != KERN_SUCCESS) {
+				/* SWEET (0247): say why the region is unusable instead of
+				 * only that it is.  After a failed map_and_slide the region
+				 * can be left with no first mapping, and every later
+				 * check_np fails on it for the rest of the boot. */
+				{
+					extern void sweet_sr_dump(void *sr);
+
+					printf("SWEET SRNOSTART: kr %d stage %d files %u maps %u "
+					    "mapkr %d err %d noslide %u\n",
+					    kr, sweet_srmap_stage, sweet_srmap_files,
+					    sweet_srmap_mappings, sweet_srmap_kr,
+					    sweet_srmap_error, sweet_srmap_noslide);
+					sweet_sr_dump(shared_region);
+				}
 				SHARED_REGION_TRACE_ERROR(("shared_region: %p [%d(%s)] "
 				    "check_np(0x%llx) "
 				    "vm_shared_region_start_address() failed\n",
@@ -2765,6 +2788,7 @@ _shared_region_map_and_slide(
 		mappings[swi].sms_max_prot &= ~VM_PROT_SLIDE;
 		sw_noslide++;
 	}
+	sweet_srmap_noslide = sw_noslide;
 	if (sw_noslide != 0) {
 		printf("SWEET SRNOSLIDE: dropped %u slide request(s), region %#llx+%#llx\n",
 		    sw_noslide, (unsigned long long)0x180000000ULL,
@@ -2820,6 +2844,9 @@ _shared_region_map_and_slide(
 	 * told apart from the screen.
 	 */
 	printf("SWEET SRMAP: files %u map_kr %#x error %d\n", files_count, kr, error);
+	sweet_srmap_files = files_count;
+	sweet_srmap_kr = (int)kr;
+	sweet_srmap_error = error;
 
 	/*
 	 * Mark that this process is now using split libraries.
@@ -2945,6 +2972,11 @@ shared_region_map_and_slide_2_np(
 
 	files_count = uap->files_count;
 	mappings_count = uap->mappings_count;
+	/* SWEET (0251): remember that dyld even got here, and how far it got:
+	 * 1 = entered, 2 = arguments accepted, 3 = copyin done. */
+	sweet_srmap_stage = 1;
+	sweet_srmap_files = files_count;
+	sweet_srmap_mappings = mappings_count;
 
 	if (files_count == 0) {
 		SHARED_REGION_TRACE_INFO(
@@ -2996,6 +3028,7 @@ shared_region_map_and_slide_2_np(
 		goto done;
 	}
 
+	sweet_srmap_stage = 2;
 	kr = shared_region_copyin(p, uap->files, files_count, sizeof(shared_files[0]), shared_files);
 	if (kr != KERN_SUCCESS) {
 		goto done;
@@ -3048,6 +3081,7 @@ shared_region_map_and_slide_2_np(
 		}
 	}
 
+	sweet_srmap_stage = 3;
 	kr = _shared_region_map_and_slide(p, files_count, shared_files, mappings_count, mappings);
 done:
 	kfree_data(shared_files, files_count * sizeof(shared_files[0]));
--- a/osfmk/vm/vm_shared_region.c
+++ b/osfmk/vm/vm_shared_region.c
@@ -202,6 +202,28 @@ static vm_shared_region_t vm_shared_region_create(
 	uint32_t      rsr_version);
 static void vm_shared_region_destroy(vm_shared_region_t shared_region);
 
+/* SWEET (0248): BSD cannot dereference vm_shared_region_t, so the check_np
+ * failure path asks this file to describe the region. */
+void
+sweet_sr_dump(void *srp)
+{
+	vm_shared_region_t sr = (vm_shared_region_t)srp;
+
+	if (sr == NULL) {
+		printf("SWEET SRDUMP: no region\n");
+		return;
+	}
+	printf("SWEET SRDUMP: base %#llx size %#llx ref %u first %#llx "
+	    "map_in_progress %d stale %d slide %#x\n",
+	    (unsigned long long)sr->sr_base_address,
+	    (unsigned long long)sr->sr_size,
+	    sr->sr_ref_count,
+	    (unsigned long long)sr->sr_first_mapping,
+	    (int)sr->sr_mapping_in_progress,
+	    (int)sr->sr_stale,
+	    sr->sr_slide);
+}
+
 static kern_return_t vm_shared_region_slide_sanity_check(vm_shared_region_slide_info_entry_t entry, mach_vm_size_t size);
 static void vm_shared_region_timeout(thread_call_param_t param0,
     thread_call_param_t param1);
