+/* SWEET (0257): after ignition completes, init stops making syscalls and stops
+ * writing to its log fd. Either it sleeps on something that will never happen or
+ * it spins in userland; the process/thread states tell the two apart. */
+int
+sweet_pid1_stat(void)
+{
+	proc_t p = proc_find(1);
+	int st = -1;
+
+	if (p != PROC_NULL) {
+		st = (int)p->p_stat;
+		proc_rele(p);
+	}
+	return st;
+}
+
+void
+sweet_dump_pid1(void)
+{
+	proc_t p = proc_find(1);
+
+	if (p == PROC_NULL) {
+		printf("SWEET PID1: no proc\n");
+		return;
+	}
+	/* p_stat: 1 SIDL, 2 SRUN, 3 SSLEEP, 4 SSTOP, 5 SZOMB */
+	printf("SWEET PID1: stat %d nice %d\n", (int)p->p_stat, (int)p->p_nice);
+	proc_rele(p);
+}
+
