+/* SWEET (R189): direct block read of signature bytes for dyld/launchd.
+ * The UBC/cluster path has delivered all-zero pages for these reads since
+ * R19 (SWEET SIGRD shows "first 00000000" while the image holds fade0cc0
+ * at the same offset), so read the extent straight from the device instead:
+ * one VNOP_BLOCKMAP per 4 KiB piece (HFS extents are 4 KiB), the R187
+ * extent-table override for dyld, then the proven sweet_ufs_read_at().
+ * Returns 1 on success, 0 to fall back to vn_rdwr().
+ */
+static int
+sweet_sig_direct_read(
+	struct vnode    *vp,
+	off_t           at,
+	uint32_t        chunk,
+	vm_offset_t     dest)
+{
+	static char     sweet_sig_bounce[PAGE_SIZE / 4];
+	static boolean_t sweet_sig_busy = FALSE;
+	extern int      sweet_ufs_read_at(daddr64_t, uint32_t, void *);
+	extern daddr64_t sweet_dyld_bpn_for(uint64_t);
+	boolean_t       is_dyld;
+	uint32_t        got;
+	uintptr_t       ca;
+
+	if (sweet_sig_busy) {
+		return 0;
+	}
+	is_dyld = vp->v_name != NULL && strcmp(vp->v_name, "dyld") == 0;
+	sweet_sig_busy = TRUE;
+
+	for (got = 0; got < chunk; ) {
+		off_t           sat = at + got;
+		uint32_t        piece = (uint32_t)(PAGE_SIZE / 4 -
+		    (sat & (PAGE_SIZE / 4 - 1)));
+		daddr64_t       bpn = 0;
+		size_t          run = 0;
+		int             err;
+
+		if (piece > chunk - got) {
+			piece = chunk - got;
+		}
+		err = VNOP_BLOCKMAP(vp, sat, piece, &bpn, &run, NULL,
+		    VNODE_READ, vfs_context_current());
+		if (err == 0 && is_dyld) {
+			daddr64_t fix = sweet_dyld_bpn_for((uint64_t)sat);
+
+			if (fix >= 0) {
+				bpn = fix;
+			}
+		}
+		if (err != 0 || bpn < 0) {
+			sweet_sig_busy = FALSE;
+			return 0;
+		}
+		if (sweet_ufs_read_at(bpn, (uint32_t)piece,
+		    sweet_sig_bounce) != 0) {
+			sweet_sig_busy = FALSE;
+			return 0;
+		}
+		memcpy((void *)((uintptr_t)dest + got), sweet_sig_bounce, piece);
+		got += piece;
+	}
+	/* R42: the direct block read wrote through the kernel D-cache; clean
+	 * to the point of coherency so csblob parsing sees the bytes. */
+	for (ca = dest; ca < dest + chunk; ca += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(ca) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_sig_busy = FALSE;
+	return 1;
+}
