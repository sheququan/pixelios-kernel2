+/* SWEET (0264): print the newest ring lines through the normal console path.
+ * Used when the boot stalls: the panel gets the tail even though no QR frame
+ * can be delivered in time. */
+void
+sweet_log_replay(int lines)
+{
+	char buf[8192];
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t n;
+	int seen = 0, start = 0;
+
+	if (lines <= 0 || total == 0) {
+		return;
+	}
+	/* SWEET (0267): the panel still holds the fill/load log, so replaying
+	 * straight onto it produced two interleaved texts.  Push the old
+	 * content off the screen first. */
+	for (int i = 0; i < 60; i++) {
+		printf("\n");
+	}
+	n = (uint64_t)lines * 160;             /* generous: 160 bytes per line */
+	if (n > total) {
+		n = total;
+	}
+	if (n > sizeof(buf) - 1) {
+		n = sizeof(buf) - 1;
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		buf[i] = sweet_log_ring[(total - n + i) % SWEET_LOG_SIZE];
+	}
+	buf[n] = 0;
+
+	/* walk backwards to the line boundary that keeps `lines` lines */
+	for (uint64_t i = n; i > 0; i--) {
+		if (buf[i - 1] == '\n' && ++seen > lines) {
+			start = (int)i;
+			break;
+		}
+	}
+	for (int i = start; buf[i]; ) {
+		char line[160];
+		int k = 0;
+
+		while (buf[i] && buf[i] != '\n' && k < (int)sizeof(line) - 1) {
+			line[k++] = buf[i++];
+		}
+		while (buf[i] && buf[i] != '\n') {
+			i++;
+		}
+		if (buf[i] == '\n') {
+			i++;
+		}
+		line[k] = 0;
+		if (k) {
+			printf("%s\n", line);
+		}
+	}
+}
