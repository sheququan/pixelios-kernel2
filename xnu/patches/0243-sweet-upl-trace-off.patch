+/* SWEET (0241): the UPL/commit traces were written one round at a time and now
+ * print five lines per page-in, which floods the console (and starves the QR
+ * thread on a single CPU).  Off unless sweetupl=1. */
+static int sweet_upl_trace_state;
+
+int sweet_upl_trace_on(void);
+
+int
+sweet_upl_trace_on(void)
+{
+	if (sweet_upl_trace_state == 0) {
+		int v = 0;
+
+		sweet_upl_trace_state = (PE_state.bootArgs != NULL &&
+		    PE_parse_boot_argn("sweetupl", &v, sizeof(v)) && v != 0) ? 2 : 1;
+	}
+	return sweet_upl_trace_state == 2;
+}
